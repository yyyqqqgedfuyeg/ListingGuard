# ==============================================================================
# ListingGuard - Environment Variables Template
# ==============================================================================

# LLM Configuration (OpenAI Compatible: DeepSeek, Qwen, GPT-4o, etc.)
OPENAI_API_KEY=your_openai_or_deepseek_api_key_here
OPENAI_BASE_URL=https://api.deepseek.com/v1
MODEL_NAME=deepseek-chat

# Backup/Alternative LLM Endpoint
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# Embedding Model Configuration (DashScope Text-Embedding-v3 or OpenAI text-embedding-3-small)
DASHSCOPE_API_KEY=your_dashscope_api_key_here
EMBEDDING_MODEL_NAME=text-embedding-v3

# Agent Inference & Risk Control Settings
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4096
LLM_MAX_RETRIES=3
LLM_STREAMING=false
